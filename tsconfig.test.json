{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["vitest.config.ts", "packages/*/test/**/*.ts", "packages/*/test/**/*.tsx"]
}
